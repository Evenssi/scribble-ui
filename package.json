{
  "name": "scribble-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo root for scribble-ui — a hand-drawn React component library.",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter docs dev",
    "build": "pnpm -r build",
    "build:core": "pnpm --filter scribble-ui build",
    "build:docs": "pnpm --filter docs build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm --filter scribble-ui test",
    "test:coverage": "pnpm --filter scribble-ui test --coverage",
    "test:e2e": "pnpm --filter @scribble-ui/e2e test",
    "test:e2e:ui": "pnpm --filter @scribble-ui/e2e test:ui",
    "test:e2e:update": "pnpm --filter @scribble-ui/e2e test:update",
    "typecheck": "pnpm -r typecheck",
    "i18n:check": "pnpm --filter docs i18n:check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "eslint": "^9.16.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "typescript-eslint": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
